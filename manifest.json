{
  "manifest_version": 3,
  "name": "YT DOWNLOADER",
  "short_name": "YT DOWNLOADER",
  "version": "1.0.0",
  "description": "Download YouTube videos and audio in MP4, WebM, MKV or M4A at any quality. Made with love by Archimetrix.",
  "author": "Archimetrix",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "alarms"
  ],
  "action": {
    "default_title": "YT DOWNLOADER - queue & history",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "key": ""
}